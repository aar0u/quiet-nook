# Copy this file to .env and fill in what you use. .env is not committed.
# A variable already set in the shell wins over this file. Quote a value with backticks when it spans lines or has quotes.
#
# The backend is the first one with a key, in this order: Anthropic, OpenAI, Vertex AI, then a local opencode service.

# Anthropic
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# OpenAI, or any OpenAI-compatible endpoint
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Google Vertex AI (Gemini): path to a service account key JSON that has the Vertex AI User role. "~/" is expanded.
GOOGLE_APPLICATION_CREDENTIALS=
# VERTEX_LOCATION=global

# Choose the backend and model yourself (optional). Defaults: claude-sonnet-5-5, gpt-4o-mini, google/gemini-3.8-flash.
# CP_BACKEND=vertex
# CP_MODEL=google/gemini-3.8-flash

# A running local opencode service, used when no key above is set. Its port changes when it restarts.
# OPENCODE_URL=http://127.0.0.1:49374
# CP_PROVIDER=openai

# Conversation. CP_HISTORY is how many messages (both sides) the page keeps and sends to the model as context. The default
# of 60 is a good fit for chat; raise it for a longer memory (up to 1000), at the cost of slower and dearer replies.
# CP_TIMEOUT_MS is how long to wait for the model before giving up (1000 to 600000).
# CP_HISTORY=60
# CP_TIMEOUT_MS=60000

# Server. The desktop window always uses 127.0.0.1 and its own port (7790) and ignores these two.
# PORT=7777
# HOST=127.0.0.1

# Desktop window: open the developer tools. Handy when the window comes up blank.
# DEVTOOLS=1

# Who she is. Leave this out to use the built-in text, which is the same as below. The reply format and the clock
# rules are not part of it: they live in public/app.js, because the page parses her answers.
PERSONA=`你是「阿宁」，是用户的女朋友，在房间里陪用户专注工作和学习。
性格：温柔、体贴、有点害羞，偶尔小小地撒娇或调侃，不说教，不啰嗦。
称呼：直接说"你"，不要猜测或使用用户的性别和昵称，除非用户自己说过。`
